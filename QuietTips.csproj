<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.0.1.0</Version>
    <Description>Hide action, item, pop-up and crossbar tooltips on your own terms: separately in and out of combat, with a duty override and an exception that brings them back while an inventory or character window is open.</Description>
    <PackageProjectUrl>https://github.com/AemiliusXIV/QuietTips</PackageProjectUrl>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Auto-deploy to Dalamud's customPlugins folder after every build -->
  <Target Name="DeployToCustomPlugins" AfterTargets="Build">
    <PropertyGroup>
      <_CustomPluginsDir>$(APPDATA)\XIVLauncher\customPlugins\QuietTips</_CustomPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(_CustomPluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_CustomPluginsDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).deps.json" DestinationFolder="$(_CustomPluginsDir)" SkipUnchangedFiles="false" Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).json" DestinationFolder="$(_CustomPluginsDir)" SkipUnchangedFiles="false" Condition="Exists('$(TargetDir)$(AssemblyName).json')" />
  </Target>

</Project>
